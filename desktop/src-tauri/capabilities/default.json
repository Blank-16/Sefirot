{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default permissions for the SEFIROT desktop window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    {
      "identifier": "shell:allow-spawn",
      "allow": [
        {
          "name": "binaries/sefirot-server",
          "sidecar": true,
          "args": [
            "--port",
            "0",
            "--data-dir",
            {
              "validator": ".+"
            },
            "--ready-file",
            {
              "validator": ".+"
            }
          ]
        }
      ]
    }
  ]
}
